# Normalize line endings for everyone (Windows, Mac, Linux)
# Text files are stored in the repo as LF, and checked out using
# each platform's native line ending automatically.

* text=auto eol=lf

# Explicitly treat these as text
*.md text
*.yml text
*.yaml text
*.json text
*.py text
*.js text
*.jsx text
*.ts text
*.tsx text
*.pl text
*.sh text eol=lf
*.gitignore text

# Windows-specific scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — do not touch line endings at all
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pkl binary
*.h5 binary
*.joblib binary
